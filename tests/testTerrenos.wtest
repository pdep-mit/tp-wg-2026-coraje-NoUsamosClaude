
import wollok.game.*
import terrenos.*
import personajes.*

describe "Terrenos" {

    method initialize() {
        fuego.reiniciar()
        agua.reiniciar()
    }

    test "Fuego sobrevive a Lava" {
        new Lava(position = game.at(1, 1)).interactuarCon(fuego)

        assert.that(fuego.vivo())
    }

    test "Agua muere en Lava" {
        new Lava(position = game.at(1, 1)).interactuarCon(agua)

        assert.notThat(agua.vivo())
    }

    test "Agua sobrevive en ZonaAgua" {
        new ZonaAgua(position = game.at(1, 1)).interactuarCon(agua)

        assert.that(agua.vivo())
    }

    test "Fuego muere en ZonaAgua" {
        new ZonaAgua(position = game.at(1, 1)).interactuarCon(fuego)

        assert.notThat(fuego.vivo())
    }

    test "Fuego muere en Acido" {
        new Acido(position = game.at(1, 1)).interactuarCon(fuego)

        assert.notThat(fuego.vivo())
    }

    test "Agua muere en Acido" {
        new Acido(position = game.at(1, 1)).interactuarCon(agua)

        assert.notThat(agua.vivo())
    }

    test "Acido no bloquea el movimiento" {
        const acido = new Acido(position = game.at(1, 1))

        assert.notThat(acido.esSolido())
    }

    test "Los terrenos tienen comportamientos diferentes" {
        const lava = new Lava(position = game.at(1, 1))
        const zonaAgua = new ZonaAgua(position = game.at(2, 2))
        const acido = new Acido(position = game.at(3, 3))

        lava.interactuarCon(fuego)
        zonaAgua.interactuarCon(agua)

        assert.that(fuego.vivo())
        assert.that(agua.vivo())

        acido.interactuarCon(fuego)
        acido.interactuarCon(agua)

        assert.notThat(fuego.vivo())
        assert.notThat(agua.vivo())
    }
}
