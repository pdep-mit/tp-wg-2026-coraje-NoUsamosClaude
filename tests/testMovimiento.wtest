import personajes.*
import direcciones.*
import paredes.*
import terrenos.*
import puertas.*

describe "Tests de movimiento" {

    method initialize() {
        game.width(10)
        game.height(10)
        fuego.reiniciar()
        agua.reiniciar()
        fuego.position(game.at(5, 5))
        agua.position(game.at(2, 2))
    }

    test "Fuego se mueve en las cuatro direcciones" {
        fuego.mover(arriba)
        assert.equals(game.at(5, 6), fuego.position())

        fuego.mover(derecha)
        assert.equals(game.at(6, 6), fuego.position())

        fuego.mover(abajo)
        assert.equals(game.at(6, 5), fuego.position())

        fuego.mover(izquierda)
        assert.equals(game.at(5, 5), fuego.position())
    }

    test "Agua se mueve independientemente de fuego" {
        agua.mover(derecha)

        assert.equals(game.at(3, 2), agua.position())
        assert.equals(game.at(5, 5), fuego.position())
    }

    test "No se mueve contra una pared" {
        game.addVisual(new Pared(position = game.at(5, 6)))

        fuego.mover(arriba)

        assert.equals(game.at(5, 5), fuego.position())
    }

    test "La pared bloquea tambien a agua" {
        game.addVisual(new Pared(position = game.at(3, 2)))

        agua.mover(derecha)

        assert.equals(game.at(2, 2), agua.position())
    }

    test "No sale del tablero" {
        fuego.position(game.at(0, 0))

        fuego.mover(izquierda)
        fuego.mover(abajo)

        assert.equals(game.at(0, 0), fuego.position())
    }

    test "Un personaje muerto no se mueve" {
        fuego.morir()

        fuego.mover(arriba)

        assert.equals(game.at(5, 5), fuego.position())
    }

    test "Agua muere al entrar a la lava" {
        game.addVisual(new Lava(position = game.at(3, 2)))

        agua.mover(derecha)

        assert.notThat(agua.vivo())
    }

    test "Fuego pasa por la lava y sigue vivo" {
        game.addVisual(new Lava(position = game.at(5, 6)))

        fuego.mover(arriba)

        assert.that(fuego.vivo())
    }

    test "Fuego muere al entrar al agua" {
        game.addVisual(new ZonaAgua(position = game.at(6, 5)))

        fuego.mover(derecha)

        assert.notThat(fuego.vivo())
    }

    test "Fuego llega a su puerta al moverse sobre ella" {
        game.addVisual(new PuertaFuego(position = game.at(5, 4)))

        fuego.mover(abajo)

        assert.that(fuego.llegoAPuerta())
    }
}
