import terrenos.*
import personajes.*

describe "Terrenos" {

    method initialize() {
        fuego.reiniciar()
        agua.reiniciar()
    }

    test "Fuego sobrevive a Lava" {
        new Lava(position = game.at(1, 1)).interactuarCon(fuego)

        assert.that(fuego.vivo())
    }

    test "Agua muere en Lava" {
        new Lava(position = game.at(1, 1)).interactuarCon(agua)

        assert.notThat(agua.vivo())
    }

    test "Agua sobrevive en ZonaAgua" {
        new ZonaAgua(position = game.at(1, 1)).interactuarCon(agua)

        assert.that(agua.vivo())
    }

    test "Fuego muere en ZonaAgua" {
        new ZonaAgua(position = game.at(1, 1)).interactuarCon(fuego)

        assert.notThat(fuego.vivo())
    }
}