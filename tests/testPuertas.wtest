import puertas.*
import personajes.*

describe "Tests de puertas" {

    method initialize() {
        fuego.reiniciar()
        agua.reiniciar()
    }

    test "Fuego llega a su puerta" {
        const puertaFuego = new PuertaFuego(position = game.at(1, 1))

        puertaFuego.interactuarCon(fuego)

        assert.that(fuego.llegoAPuerta())
    }

    test "Fuego no llega por la puerta de Agua" {
        const puertaAgua = new PuertaAgua(position = game.at(1, 1))

        puertaAgua.interactuarCon(fuego)

        assert.notThat(fuego.llegoAPuerta())
    }

    test "Agua llega a su puerta" {
        const puertaAgua = new PuertaAgua(position = game.at(1, 1))

        puertaAgua.interactuarCon(agua)

        assert.that(agua.llegoAPuerta())
    }

    test "Agua no llega por la puerta de Fuego" {
        const puertaFuego = new PuertaFuego(position = game.at(1, 1))

        puertaFuego.interactuarCon(agua)

        assert.notThat(agua.llegoAPuerta())
    }
}