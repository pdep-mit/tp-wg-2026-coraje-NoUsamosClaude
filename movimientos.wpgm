import wollok.game.*
import personajes.*
import direcciones.*
import paredes.*

program movimientos {

    game.height(10)
    game.width(10)

    fuego.position(game.at(1, 1))
    agua.position(game.at(1, 2))
    game.addVisual(fuego)
    game.addVisual(agua)
    game.addVisual(new Pared(position = game.at(5, 5)))
    game.addVisual(new Pared(position = game.at(5, 6)))
    game.addVisual(new Pared(position = game.at(5, 4)))

    keyboard.w().whilePressedDo({
        fuego.mover(arriba)
    }, 100)

    keyboard.s().whilePressedDo({
        fuego.mover(abajo)
    }, 100)

    keyboard.a().whilePressedDo({
        fuego.mover(izquierda)
    }, 100)

    keyboard.d().whilePressedDo({
        fuego.mover(derecha)
    }, 100)

    keyboard.up().whilePressedDo({
        agua.mover(arriba)
    }, 100)

    keyboard.down().whilePressedDo({
        agua.mover(abajo)
    }, 100)

    keyboard.left().whilePressedDo({
        agua.mover(izquierda)
    }, 100)

    keyboard.right().whilePressedDo({
        agua.mover(derecha)
    }, 100)

    game.start()
}
